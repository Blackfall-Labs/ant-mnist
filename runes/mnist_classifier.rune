meta {
  name "mnist_classifier"
  version 2
  description "MNIST digit classification with thermal mastery learning"
}
use :ant_ml
use :mnist

# Architecture: 784 → 300 → 100 → 10
# W1, W2 frozen random projections. W3 learned via thermal mastery.
#
# Pressure math for W3 (10×100):
#   ~25 active inputs per sample (top 25% of 100 hidden neurons)
#   activity_strength: up to 15
#   error_mag: 1-2
#   max pressure per sample: ~750
#   threshold 500 → requires sustained agreement over multiple samples
#   participation gate 100 → must see 100 samples before learning

def build_network() do
  thermal_load_synaptic("w1", 300, 784, 42)
  thermal_load_synaptic("w2", 100, 300, 7919)
  thermal_load_synaptic("w3", 10, 100, 104729)
end

def forward(input) do
  w1 = thermal_load_synaptic("w1", 300, 784, 42)
  w2 = thermal_load_synaptic("w2", 100, 300, 7919)
  w3 = thermal_load_synaptic("w3", 10, 100, 104729)

  h1 = thermal_matmul(input, w1)
  h1 = relu(h1)
  h2 = thermal_matmul(h1, w2)
  h2 = relu(h2)
  thermal_matmul(h2, w3)
end

def predict(input) do
  argmax(forward(input))
end

def train_step(input, label) do
  w1 = thermal_load_synaptic("w1", 300, 784, 42)
  w2 = thermal_load_synaptic("w2", 100, 300, 7919)
  w3 = thermal_load_synaptic("w3", 10, 100, 104729)

  # Forward
  h1 = thermal_matmul(input, w1)
  h1 = relu(h1)
  h2 = thermal_matmul(h1, w2)
  h2 = relu(h2)
  out = thermal_matmul(h2, w3)

  predicted = argmax(out)
  correct = predicted == label

  # Target: correct class excitatory, others inhibitory
  # Moderate magnitudes to avoid saturation
  target = onehot(label, 10, 40, 20)
  out_c = clamp(out, -40, 40)

  # Output region mastery — only W3 learns for now
  # Config: [threshold, decay, gate, cooling, warming_step, warming_threshold]
  #   threshold 500: needs sustained pressure over multiple samples (max ~750/sample)
  #   decay 10: moderate per-cycle decay, prevents stale pressure
  #   gate 100: must participate in 100 samples before learning
  #   cooling 500: slow cooling, 500 hits per degree
  #   warming_step 5: gentle re-warming on sustained error
  #   warming_threshold 1000: large pressure accumulation needed to warm back up
  thermal_mastery_update(w3, h2, out_c, target, correct, [500, 10, 100, 500, 5, 1000])

  predicted
end

def decay_all() do
  w3 = thermal_load_synaptic("w3", 10, 100, 104729)
  thermal_decay(w3)
end

main do
  print("Loading MNIST...")
  train_data = load_train()
  test_data = load_test()
  n_train = dataset_len(train_data)
  n_test = dataset_len(test_data)
  print("Loaded: ", n_train, " train, ", n_test, " test")

  build_network()

  # Baseline evaluation (first 1000 test images for speed)
  print("\n--- Baseline (random strengths) ---")
  correct = 0
  1000.times do |i|
    sample = get_sample(test_data, i)
    input = slice(sample, 0, 784)
    label = slice(sample, 784, 1)
    label = argmax(label)
    pred = predict(input)
    if pred == label do
      correct = correct + 1
    end
  end
  print("Baseline: ", correct, "/1000")

  # Training: 40 cycles
  40.times do |cycle|
    train_correct = 0
    n_train.times do |i|
      sample = get_sample(train_data, i)
      input = slice(sample, 0, 784)
      label = slice(sample, 784, 1)
      label = argmax(label)
      pred = train_step(input, label)
      if pred == label do
        train_correct = train_correct + 1
      end
    end
    decay_all()

    # Evaluate on first 1000 test images
    test_correct = 0
    1000.times do |i|
      sample = get_sample(test_data, i)
      input = slice(sample, 0, 784)
      label = slice(sample, 784, 1)
      label = argmax(label)
      pred = predict(input)
      if pred == label do
        test_correct = test_correct + 1
      end
    end

    print("Cycle ", cycle + 1, ": train ", train_correct, "/", n_train, ", test ", test_correct, "/1000")

    # Thermal summary
    w3 = thermal_load_synaptic("w3", 10, 100, 104729)
    temps = thermal_summary(w3)
    print("  W3 temps: HOT=", temps[0], " WARM=", temps[1], " COOL=", temps[2], " COLD=", temps[3])
  end

  print("\n=== Done ===")
end
