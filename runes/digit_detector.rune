meta {
  name "digit_detector"
  version 3
  description "Spatial correlation detector — returns 784 confidence signals"
}
use :ant_ml

# Architecture: template-based spatial correlation.
# The hidden layer IS the template — 784 signals representing
# what this digit looks like at each pixel position.
# Correlation produces 784 output signals preserving polarity,
# magnitude, and confidence (multiplier).
#
# No matmul. No output weights. Pure signal correlation.

def imprint(input, row) do
  template = thermal_load_synaptic(prefix + ".template", 1, 784)
  thermal_imprint(template, input, row)
end

def finish_imprint(count) do
  template = thermal_load_synaptic(prefix + ".template", 1, 784)
  thermal_normalize_imprint(template, count)
end

def finish_imprint_row(count, row) do
  template = thermal_load_synaptic(prefix + ".template", 1, 784)
  thermal_normalize_imprint(template, count, row)
end

# Correlate input against template.
# Returns 784 signals: mul(input, template) element-wise.
# Each signal preserves polarity (agree/disagree), magnitude
# (feature strength), and the product encodes confidence.
def correlate(input) do
  template = thermal_load_synaptic(prefix + ".template", 1, 784)
  # Get template as signal array via matmul with identity-like access
  # Actually we need raw template values — use thermal_matmul with
  # a single-element input [1] to extract the row? No...
  # We need a verb that reads thermal weights as signals.
  # For now: element-wise multiply input × template
  # thermal_matmul gives us dot product (scalar), not element-wise.
  # We need the raw template values exposed.

  # Use the signal-level mul verb: mul(input, template_signals)
  # But template_signals needs to be extracted as an array.
  # This requires a new verb: thermal_read(handle) → array of currents
  tmpl = thermal_read(template)
  mul(input, tmpl)
end

# Scalar confidence: sum of absolute correlation values.
# Higher = more overlap between input and template.
def confidence(input) do
  corr = correlate(input)
  sum(abs(corr))
end
